generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  department          String
  role                String               @default("claimer") // viewer | claimer | poster
  offers              Offer[]              @relation("OfferingUser")
  claims              Claim[]              @relation("ClaimingUser")
  notifications       Notification[]
  searchSubscriptions SearchSubscription[]
  createdAt           DateTime             @default(now())
}

model Offer {
  id              String   @id @default(cuid())
  offeringUserId  String
  offeringUser    User     @relation("OfferingUser", fields: [offeringUserId], references: [id])
  category        String   @default("OTHER") // see CATEGORIES in src/lib/categories.ts
  subCategory     String   @default("") // see subcategories in src/lib/categories.ts
  itemName        String
  description     String
  quantity        Int
  condition       String   // LIKE_NEW | GOOD | FAIR | POOR
  location        String
  scrapDate       DateTime
  estimatedValue  Int      @default(0) // in NIS, used for analytics
  status          String   @default("AVAILABLE") // AVAILABLE | CLAIMED | COMPLETED | SCRAPPED
  images          String[] @default([]) // data URLs
  claim           Claim?
  subscriptionMatches SearchSubscriptionMatch[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model Claim {
  id              String   @id @default(cuid())
  offerId         String   @unique
  offer           Offer    @relation(fields: [offerId], references: [id])
  claimingUserId  String
  claimingUser    User     @relation("ClaimingUser", fields: [claimingUserId], references: [id])
  status          String   @default("PENDING") // PENDING | PICKUP_SCHEDULED | COMPLETED | CANCELLED
  notes           String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  updatedAt       DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model SearchSubscription {
  id        String                    @id @default(cuid())
  userId    String
  user      User                      @relation(fields: [userId], references: [id])
  query     String
  matches   SearchSubscriptionMatch[]
  createdAt DateTime                  @default(now())

  @@index([userId])
}

model SearchSubscriptionMatch {
  id             String             @id @default(cuid())
  subscriptionId String
  subscription   SearchSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  offerId        String
  offer          Offer              @relation(fields: [offerId], references: [id], onDelete: Cascade)
  dismissedAt    DateTime?
  createdAt      DateTime           @default(now())

  @@unique([subscriptionId, offerId])
  @@index([subscriptionId, dismissedAt])
}
