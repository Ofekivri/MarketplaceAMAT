# Copy to .env and fill in. Never commit the filled-in file.

# --- Database (required) ---
# Postgres connection string.
# Local dev with docker-compose.yml:
#   postgresql://amat:amat@localhost:5432/marketplaceamat?schema=public
DATABASE_URL=

# --- Image storage (required for photo uploads) ---
# Currently Vercel Blob. See src/lib/storage.ts — the only file to change
# when moving to S3 / Azure Blob / an internal store.
BLOB_READ_WRITE_TOKEN=

# Hostname allowed to serve offer images, used by next/image.
# Leave empty to keep the Vercel Blob default; set it when storage moves.
IMAGE_HOST=

# --- Scheduled job (required for the overdue sweep) ---
# Shared secret for GET /api/cron/check-overdue.
# The scheduler must send:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
