# Local dev (matches docker-compose.yml):
DATABASE_URL="postgresql://amat:amat@localhost:5432/marketplaceamat?schema=public"

# For Vercel/Neon, use the pooled connection string from your Neon dashboard.
# Example: postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Vercel Blob token (Project → Storage → Blob → Connect will auto-inject it in prod/preview).
# For local dev, run `vercel env pull` after connecting a Blob store.
BLOB_READ_WRITE_TOKEN=
